---
import Base from '../layouts/Base.astro';
import { person, technologies, languages } from '../data/cv';
---

<Base>
  <div class="hero">
    <img class="avatar" src={person.photo} alt={`Porträt von ${person.name}`} width="132" height="132" />
    <div>
      <h1>{person.name}</h1>
      <p class="meta">{person.role} · {person.location}</p>
    </div>
  </div>
  <p class="lede">{person.intro}</p>

  <section aria-labelledby="nutshell">
    <h2 id="nutshell">Kurz gesagt</h2>
    <ul class="plain">
      {person.nutshell.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section aria-labelledby="tech">
    <h2 id="tech">Technologien</h2>
    <ul class="chips">
      {technologies.map((t) => <li>{t}</li>)}
    </ul>
  </section>

  <section aria-labelledby="lang">
    <h2 id="lang">Sprachen</h2>
    <ul class="plain">
      {languages.map((l) => <li><strong>{l.name}</strong>: {l.level}</li>)}
    </ul>
  </section>

  <section aria-labelledby="contact">
    <h2 id="contact">Kontakt</h2>
    <p>Am besten erreichst du mich per E-Mail: <a href={`mailto:${person.email}`}>{person.email}</a></p>
    <div class="actions">
      {person.links.map((l) => <a href={l.href} rel="me noopener">{l.label}</a>)}
      <a href="/cv">Lebenslauf ansehen</a>
    </div>
  </section>
</Base>
